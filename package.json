{
  "name": "inkmark",
  "version": "1.0.0",
  "description": "A Typora-like WYSIWYG Markdown editor for the desktop",
  "main": "./out/main/index.js",
  "desktopName": "inkmark",
  "author": "InkMark",
  "license": "MIT",
  "homepage": "https://example.com/inkmark",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build:unpack": "electron-vite build && electron-builder --dir",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@milkdown/kit": "^7.22.1",
    "@milkdown/plugin-prism": "^7.22.1",
    "@milkdown/react": "^7.22.1",
    "@milkdown/theme-nord": "^7.22.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  }
}
